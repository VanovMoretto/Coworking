rules_version = '2';

// Regras de acesso ao Firestore. Só valem depois de publicadas:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // dados do perfil: cada pessoa só lê e altera o próprio
    match /users/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
    }

    match /reservations/{reservationId} {
      // quem está logado vê as reservas, para saber quais horários estão ocupados
      allow read: if request.auth != null;
      // só cria reserva em nome próprio, e só cancela as suas
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
